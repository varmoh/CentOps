{
"items": [
{{#each entries}}
    {
    "id": "{{id}}",
    "createdAt": "{{createdAt}}",
    "userIdCode": "{{userIdCode}}",
    "ipAddress": "{{ipAddress}}",
    "action": "{{action}}",
    "userAgent": "{{userAgent}}"
    }{{#unless @last}},{{/unless}}
{{/each}}
],
"page": {{page}},
"pageSize": {{pageSize}},
"totalPages": {{#if entries.[0]}}{{entries.[0].totalPages}}{{else}}0{{/if}}
}
