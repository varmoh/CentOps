{
"items": [
{{#each entries}}
    {
    "manifestId": "{{manifestId}}",
    "clientId": "{{clientId}}",
    "name": "{{name}}",
    "gitHelmBranch": "{{gitHelmBranch}}",
    "createdAt": "{{createdAt}}",
    "updatedAt": {{#if updatedAt}}"{{updatedAt}}"{{else}}null{{/if}},
    "deployedAt": {{#if deployedAt}}"{{deployedAt}}"{{else}}null{{/if}},
    "gitHelmRepository": {{#if gitHelmRepository}}"{{gitHelmRepository}}"{{else}}null{{/if}},
    "gitHelmPath": {{#if gitHelmPath}}"{{gitHelmPath}}"{{else}}null{{/if}}
    }{{#unless @last}},{{/unless}}
{{/each}}
],
"page": {{page}},
"pageSize": {{pageSize}},
"totalPages": {{#if entries.[0]}}{{entries.[0].totalPages}}{{else}}0{{/if}}
}
